---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { CardGrid, Card } from "@astrojs/starlight/components";
import fs from "fs";
import path from "path";

const versionsDir = path.resolve("src/data/versions");
const versionFolders = fs.readdirSync(versionsDir).filter((folder) => {
  const jsonPath = path.join(versionsDir, folder, "codegen.json");
  return fs.existsSync(jsonPath);
});

const stats = {
  win: { total: 0, address: 0, inline: 0, link: 0, missing: 0 },
  imac: { total: 0, address: 0, inline: 0, link: 0, missing: 0 },
  m1: { total: 0, address: 0, inline: 0, link: 0, missing: 0 },
  ios: { total: 0, address: 0, inline: 0, link: 0, missing: 0 },
  android32: { total: 0, address: 0, inline: 0, link: 0, missing: 0 },
  android64: { total: 0, address: 0, inline: 0, link: 0, missing: 0 }
};

const displayNames = {
  win: "Windows",
  imac: "macOS Intel",
  m1: "macOS ARM",
  ios: "iOS",
  android32: "Android 32-bit",
  android64: "Android 64-bit"
};

const jsonPath = path.join(versionsDir, "2.2081", "codegen.json");
const raw = fs.readFileSync(jsonPath, "utf-8");
const data = JSON.parse(raw);

for (const cls of data.classes) {
  for (const fn of cls.functions) {
    for (const [platform, val] of Object.entries(fn.bindings ?? {})) {
      if (stats[platform]) {
        stats[platform].total += 1
        if (val == "link") {
          stats[platform].link += 1
        } else if (val == "inline") {
          stats[platform].inline += 1
        } else if (val == null) {
          stats[platform].missing += 1
        } else {
          stats[platform].address += 1
        }
      }
    }
  }
}
---

<StarlightPage frontmatter={{ title: "Bindings Statistics", template: "splash" }}>
  <CardGrid>
    {Object.entries(stats).map(([platform, data]) => {
      const pct = (n) => data.total ? ((n / data.total) * 100).toFixed(1) + '%' : '0%';
      const title = displayNames[platform] ?? platform;
      return (
        <Card title={title}>
          <ul>
            <li><strong>Found:</strong> {data.total}</li>
            <li><strong>Available:</strong> {data.address} ({pct(data.address)})</li>
            <li><strong>Inlines:</strong> {data.inline} ({pct(data.inline)})</li>
            <li><strong>Linked:</strong> {data.link} ({pct(data.link)})</li>
            <li><strong>Missing:</strong> {data.missing} ({pct(data.missing)})</li>
          </ul>
        </Card>
      );
    })}
  </CardGrid>
  <strong>Warning: This information may be incorrect. I recommend looking at <a href="https://prevter.github.io/bindings-meta/" target="_blank">bindings meta</a> for a more detailed analysis.</strong>
</StarlightPage>
